 dm/host/hle_svc.c           |  4 ++++
 dm/host/web_apple.m         |  4 ++++
 dm/ios/Sources/DmGamepad.m  | 29 ++++++++++++++++++++++++--
 dm/ios/Sources/DmLayout.h   |  2 ++
 dm/ios/Sources/DmRotation.h |  2 ++
 dm/ios/Sources/front_ios.m  | 41 +++++++++++++++++++++++++++++--------
 dm/ios/Sources/main.m       |  6 ++++++
 8 files changed, 81 insertions(+), 11 deletions(-)

diff --git a/dm/host/crash.c b/dm/host/crash.c
index bb2fb21..da01f3b 100644
--- a/dm/host/crash.c
+++ b/dm/host/crash.c
@@ -257,6 +257,9 @@ static void on_crash(int sig, siginfo_t *si, void *uc_) {
 }
 // The signal alternate stack is per thread: every guest thread must call this when it starts running (only then can the crash state be printed on the alternate stack on a stack overflow)
 // The alternate stack is released when the thread exits: the pthread key destructor is called at thread exit (disable the alternate stack first, then free). The game frequently starts short-lived threads, and without releasing each one leaks 64 KiB.
+#if TARGET_OS_TV
+void crash_thread_init(void) {}
+#else
 static pthread_key_t g_altstack_key __attribute__((section("__DATA,__dm_keep")));
 static pthread_once_t g_altstack_once __attribute__((section("__DATA,__dm_keep"))) = PTHREAD_ONCE_INIT;
 static void altstack_free(void *p) { stack_t off = {.ss_flags = SS_DISABLE}; sigaltstack(&off, 0); free(p); }
@@ -267,6 +270,7 @@ void crash_thread_init(void) {
     stack_t ss = {.ss_sp = malloc(65536), .ss_size = 65536}; sigaltstack(&ss, 0);
     pthread_setspecific(g_altstack_key, ss.ss_sp);
 }
+#endif
 void crash_install(void) {
     crash_thread_init();
     struct sigaction sa = {.sa_sigaction = on_crash, .sa_flags = SA_SIGINFO | SA_ONSTACK};
diff --git a/dm/host/hle_svc.c b/dm/host/hle_svc.c
index a2817ee..61d546c 100644
--- a/dm/host/hle_svc.c
+++ b/dm/host/hle_svc.c
@@ -159,6 +159,9 @@ static void guest_file_sweep(void);
 // The query asks the system's cache-delete service: 4-65 ms on the Mac, where it gave 14.73 GB for 14.71 of f_bavail (little is purgeable there). -1 when it fails
 static char g_gf_dir[1024];
 static double guest_file_free_important(void) {
+#if TARGET_OS_TV
+    return -1;
+#else
     CFURLRef u = CFURLCreateFromFileSystemRepresentation(NULL, (const UInt8 *)g_gf_dir, (CFIndex)strlen(g_gf_dir), true);   // a new URL each time: one caches the values it gave
     double r = -1; int64_t x; CFTypeRef v = NULL;
     if (!u) return r;
@@ -167,6 +170,7 @@ static double guest_file_free_important(void) {
         CFRelease(v);
     }
     CFRelease(u); return r;
+#endif
 }
 // Every second the room left on the files' disk (they all lie on one volume): its free space less what the files' dirty pages may take when the kernel writes them out. Under
 // DM_GUEST_FILE_MIN_FREE (default 2G) the game is stopped (exit code 87; the memory watchdog's is 86, hle_nvn.c), before a full disk leaves the kernel no room to write the guest's pages out.
