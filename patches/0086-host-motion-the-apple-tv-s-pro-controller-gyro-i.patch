index 87cb9ac..6ff54a9 100644
--- a/dm/ios/project_tv.yml
+++ b/dm/ios/project_tv.yml
@@ -66,7 +66,7 @@ targets:
       TARGETED_DEVICE_FAMILY: "3"
       ENABLE_BITCODE: NO
       GCC_C_LANGUAGE_STANDARD: gnu11
-      OTHER_CFLAGS: $(inherited) -mcpu=apple-m1
+      OTHER_CFLAGS: $(inherited) -mcpu=apple-m1 -DMOTION_REST_FIRST_MAX=0.35f
       CLANG_ENABLE_OBJC_ARC: YES
       DEBUG_INFORMATION_FORMAT: dwarf
       GCC_WARN_INHIBIT_ALL_WARNINGS: YES
