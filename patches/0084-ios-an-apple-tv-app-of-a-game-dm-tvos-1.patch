diff --git a/dm/ios/SourcesTV/TVSaves.m b/dm/ios/SourcesTV/TVSaves.m
new file mode 100644
index 0000000..710b5de
--- /dev/null
+++ b/dm/ios/SourcesTV/TVSaves.m
@@ -0,0 +1,103 @@
+#import <Foundation/Foundation.h>
+#include <compression.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "save_sync.h"
+
+#define STORE_LIMIT (900 * 1024)
+#define HEADER 12
+static NSString *const PREFIX = @"dmsave:";
+static const char MAGIC[4] = {'D', 'M', 'Z', '2'};
+
+static NSString *caches_directory(void) {
+    return NSSearchPathForDirectoriesInDomains(NSCachesDirectory, NSUserDomainMask, YES).firstObject;
+}
+
+static NSString *store_key(const char *cloud) {
+    NSString *path = @(cloud);
+    NSRange at = [path rangeOfString:@"/tv-saves/"];
+    return [PREFIX stringByAppendingString:at.location == NSNotFound ? path.lastPathComponent : [path substringFromIndex:NSMaxRange(at)]];
+}
+
+static NSString *spill_path(NSString *key) {
+    NSString *name = [[key substringFromIndex:PREFIX.length] stringByReplacingOccurrencesOfString:@"/" withString:@"_"];
+    NSString *library = NSSearchPathForDirectoriesInDomains(NSLibraryDirectory, NSUserDomainMask, YES).firstObject;
+    return [[library stringByAppendingPathComponent:@"Preferences/tv-saves"] stringByAppendingPathComponent:name];
+}
+
+static NSUInteger stored_size_except(NSUserDefaults *defaults, NSString *key) {
+    NSUInteger total = 0;
+    NSDictionary *all = defaults.dictionaryRepresentation;
+    for (NSString *k in all) if ([k hasPrefix:PREFIX] && ![k isEqualToString:key]) total += [all[k] length];
+    return total;
+}
+
+static NSData *pack_save(NSData *raw) {
+    size_t room = raw.length + raw.length / 8 + 65536;
+    NSMutableData *packed = [NSMutableData dataWithLength:HEADER + room];
+    memcpy(packed.mutableBytes, MAGIC, 4);
+    uint64_t size = raw.length; memcpy((uint8_t *)packed.mutableBytes + 4, &size, 8);
+    size_t n = compression_encode_buffer((uint8_t *)packed.mutableBytes + HEADER, room, raw.bytes, raw.length, NULL, COMPRESSION_LZFSE);
+    if (!n) return nil;
+    packed.length = HEADER + n;
+    return packed;
+}
+
+static NSData *unpack_save(NSData *packed) {
+    if (packed.length <= HEADER || memcmp(packed.bytes, MAGIC, 4)) return nil;
+    uint64_t size = 0; memcpy(&size, (const uint8_t *)packed.bytes + 4, 8);
+    NSMutableData *raw = [NSMutableData dataWithLength:size];
+    if (!raw) return nil;
+    size_t n = compression_decode_buffer(raw.mutableBytes, size, (const uint8_t *)packed.bytes + HEADER, packed.length - HEADER, NULL, COMPRESSION_LZFSE);
+    return n == size ? raw : nil;
+}
+
+static int store_in_file(NSData *packed, NSString *key, NSUserDefaults *defaults) {
+    NSString *spill = spill_path(key);
+    [NSFileManager.defaultManager createDirectoryAtPath:spill.stringByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:nil];
+    if (![packed writeToFile:spill atomically:YES]) { fprintf(stderr, "[dm] [RED] tv saves: writing %s failed\n", spill.fileSystemRepresentation); return 0; }
+    [defaults removeObjectForKey:key]; [defaults synchronize];
+    fprintf(stderr, "[dm] tv saves: %zu packed bytes kept in Library/Preferences, past the preferences' budget\n", (size_t)packed.length);
+    return 1;
+}
+
+static int store_in_defaults(NSData *packed, NSString *key, NSUserDefaults *defaults) {
+    [defaults setObject:packed forKey:key];
+    if (![defaults synchronize]) { fprintf(stderr, "[dm] [RED] tv saves: the preferences did not take the save\n"); return 0; }
+    [NSFileManager.defaultManager removeItemAtPath:spill_path(key) error:nil];
+    fprintf(stderr, "[dm] tv saves: %zu packed bytes kept in the preferences\n", (size_t)packed.length);
+    return 1;
+}
+
+int front_save_sync_store(const char *local, const char *cloud) {
+    @autoreleasepool {
+        NSData *raw = [NSData dataWithContentsOfFile:@(local)];
+        if (!raw.length) { fprintf(stderr, "[dm] [RED] tv saves: cannot read %s\n", local); return 0; }
+        NSData *packed = pack_save(raw);
+        if (!packed) { fprintf(stderr, "[dm] [RED] tv saves: a %zu-byte save did not compress\n", (size_t)raw.length); return 0; }
+        NSUserDefaults *defaults = NSUserDefaults.standardUserDefaults;
+        NSString *key = store_key(cloud);
+        if (stored_size_except(defaults, key) + packed.length > STORE_LIMIT) return store_in_file(packed, key, defaults);
+        return store_in_defaults(packed, key, defaults);
+    }
+}
+
+int front_save_sync_fetch(const char *cloud, const char *local) {
+    @autoreleasepool {
+        NSString *key = store_key(cloud);
+        NSData *packed = [NSUserDefaults.standardUserDefaults dataForKey:key] ?: [NSData dataWithContentsOfFile:spill_path(key)];
+        if (!packed) return 0;
+        NSData *raw = unpack_save(packed);
+        if (!raw) { fprintf(stderr, "[dm] [RED] tv saves: the stored save %s is damaged\n", key.UTF8String); return -1; }
+        if (![raw writeToFile:@(local) atomically:YES]) { fprintf(stderr, "[dm] [RED] tv saves: writing %s failed\n", local); return -1; }
+        return 1;
+    }
+}
+
+void dm_cloud_saves_env(void) {
+    if (getenv("DM_SAVE_SYNC")) return;
+    const char *save = getenv("DM_SAVE");
+    NSString *folder = save ? @(save).lastPathComponent : @"save";
+    setenv("DM_SAVE_SYNC", [caches_directory() stringByAppendingFormat:@"/tv-saves/%@", folder].fileSystemRepresentation, 1);
+}
diff --git a/dm/ios/project_tv.yml b/dm/ios/project_tv.yml
new file mode 100644
index 0000000..87cb9ac
--- /dev/null
+++ b/dm/ios/project_tv.yml
@@ -0,0 +1,83 @@
+# Apple TV project (xcodegen), chosen by build_ipa.sh with DM_TVOS=1. The shader libraries stay the iOS ones, which tvOS loads, so the shader chain is the same.
+# No settings screen, no in-game menu and no iCloud: SourcesTV/TVFront.m stands in for Launcher.swift and GameMenu.swift, SourcesTV/TVSaves.m keeps the saves in the app's preferences.
+name: DmIOS
+options:
+  bundleIdPrefix: ${DM_BUNDLE_ID}
+  deploymentTarget:
+    tvOS: "26.0"
+configFiles:
+  Release: Gen/dm.xcconfig
+  Debug: Gen/dm.xcconfig
+targets:
+  DmIOS:
+    type: application
+    platform: tvOS
+    sources:
+      - path: Sources
+        excludes: [Info.plist, "*.swift", DmIOS-Bridging-Header.h, CloudSaves.m, SaveSync.m]
+      - path: SourcesTV
+      - path: Gen/embed.S
+      - path: Gen/dm
+        type: folder
+        buildPhase: resources
+      - path: Gen/Assets.xcassets
+      - path: Gen/src
+      - path: Gen/main/main.c
+        compilerFlags: "-Dmain=dm_main"
+    dependencies:
+      - sdk: libcompression.tbd
+    postBuildScripts:
+      - name: Copy game resources
+        script: /bin/bash "${SRCROOT}/tools/stage_resources.sh"
+        basedOnDependencyAnalysis: false
+    info:
+      path: Gen/Info.plist
+      properties:
+        CFBundleDisplayName: ${DM_DISPLAY_NAME}
+        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
+        CFBundleShortVersionString: $(MARKETING_VERSION)
+        LSApplicationCategoryType: ${DM_APP_CATEGORY}
+        DMShowFPS: ${DM_SHOW_FPS}
+        DMLanguage: ${DM_LANG}
+        DMForkPatches: ${DM_FORK_PATCHES}
+        GCSupportsControllerUserInteraction: true
+        GCSupportedGameControllers:
+          - ProfileName: ExtendedGamepad
+        UIApplicationSceneManifest:
+          UIApplicationSupportsMultipleScenes: false
+          UISceneConfigurations:
+            UIWindowSceneSessionRoleApplication:
+              - UISceneConfigurationName: Default
+                UISceneDelegateClassName: SceneDelegate
+    settings:
+      PRODUCT_BUNDLE_IDENTIFIER: ${DM_BUNDLE_ID}
+      PRODUCT_NAME: DmIOS
+      MARKETING_VERSION: ${DM_APP_VERSION}
+      CURRENT_PROJECT_VERSION: ${DM_APP_VERSION}
+      DEVELOPMENT_TEAM: ${DM_TEAM_ID}
+      CODE_SIGN_STYLE: Automatic
+      ENABLE_USER_SCRIPT_SANDBOXING: NO
+      DM_COPY_GAME_RESOURCES: YES
+      SYMROOT: $(DM_XCODE_OUTPUT_ROOT)/Build/Products
+      OBJROOT: $(DM_XCODE_OUTPUT_ROOT)/Build/Intermediates.noindex
+      CONFIGURATION_BUILD_DIR: $(DM_XCODE_OUTPUT_ROOT)/Build/Products/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
+      CONFIGURATION_TEMP_DIR: $(DM_XCODE_OUTPUT_ROOT)/Build/Intermediates.noindex/$(PROJECT_NAME).build/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
+      ASSETCATALOG_COMPILER_APPICON_NAME: $(DM_APPICON)
+      TARGETED_DEVICE_FAMILY: "3"
+      ENABLE_BITCODE: NO
+      GCC_C_LANGUAGE_STANDARD: gnu11
+      OTHER_CFLAGS: $(inherited) -mcpu=apple-m1
+      CLANG_ENABLE_OBJC_ARC: YES
+      DEBUG_INFORMATION_FORMAT: dwarf
+      GCC_WARN_INHIBIT_ALL_WARNINGS: YES
+schemes:
+  ${DM_SCHEME_NAME}:
+    build:
+      targets:
+        DmIOS: all
+    run:
+      config: Release
+    profile:
+      config: Release
+    archive:
+      config: Release
